# Copy this file to .env.local for local development. Never commit real values.
# Use ONLY the publishable key (sb_publishable_...). A secret or service_role key
# here would be public in the browser bundle, so the build refuses to run with one.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
