{
  // Cloudflare Workers deployment of the built app (npm run build creates ./dist).
  // The name must match the Worker name in the Cloudflare dashboard.
  "name": "expenses-web",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
